COLUMN TABLE com_mdasad_gatepass_GatePasses (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  gatePassNumber NVARCHAR(20),
  movementType NVARCHAR(5000) NOT NULL,
  documentStatus NVARCHAR(5000) DEFAULT 'OPEN',
  gateEntry_ID NVARCHAR(36) NOT NULL,
  gateEntryNumber NVARCHAR(20),
  referenceType NVARCHAR(10),
  referenceNumber NVARCHAR(20),
  invoiceDate DATE,
  invoiceValue NVARCHAR(50),
  partyNumber NVARCHAR(20),
  partyName NVARCHAR(100),
  eWayBillNumber NVARCHAR(50),
  eWayBillDate DATE,
  shippingAddress NVARCHAR(250),
  vehicleNumber NVARCHAR(20) NOT NULL,
  vehicleType NVARCHAR(20),
  transporterName NVARCHAR(100),
  driverName NVARCHAR(100),
  lrNumber NVARCHAR(50),
  passDate DATE NOT NULL,
  passTime TIME,
  remarks NVARCHAR(500),
  PRIMARY KEY(ID)
)