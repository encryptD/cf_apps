COLUMN TABLE com_mdasad_gatepass_GatePassItems (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  gatePass_ID NVARCHAR(36),
  itemNumber INTEGER,
  materialCode NVARCHAR(40) NOT NULL,
  materialDescription NVARCHAR(200) NOT NULL,
  quantity DECIMAL(15, 3) NOT NULL,
  challanQuantity DECIMAL(15, 3),
  unitOfMeasure NVARCHAR(10),
  batch NVARCHAR(40),
  dateOfManufacture DATE,
  plant NVARCHAR(10),
  orderItemNumber NVARCHAR(10),
  PRIMARY KEY(ID)
)