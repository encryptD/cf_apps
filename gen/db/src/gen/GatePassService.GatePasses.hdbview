VIEW GatePassService_GatePasses AS SELECT
  GatePasses_0.createdAt,
  GatePasses_0.createdBy,
  GatePasses_0.modifiedAt,
  GatePasses_0.modifiedBy,
  GatePasses_0.ID,
  GatePasses_0.gatePassNumber,
  GatePasses_0.movementType,
  GatePasses_0.documentStatus,
  GatePasses_0.gateEntry_ID,
  GatePasses_0.gateEntryNumber,
  GatePasses_0.referenceType,
  GatePasses_0.referenceNumber,
  GatePasses_0.invoiceDate,
  GatePasses_0.invoiceValue,
  GatePasses_0.partyNumber,
  GatePasses_0.partyName,
  GatePasses_0.eWayBillNumber,
  GatePasses_0.eWayBillDate,
  GatePasses_0.shippingAddress,
  GatePasses_0.vehicleNumber,
  GatePasses_0.vehicleType,
  GatePasses_0.transporterName,
  GatePasses_0.driverName,
  GatePasses_0.lrNumber,
  GatePasses_0.passDate,
  GatePasses_0.passTime,
  GatePasses_0.remarks
FROM com_mdasad_gatepass_GatePasses AS GatePasses_0