COLUMN TABLE com_mdasad_gatepass_InvoiceHeaders (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  billingDocument NVARCHAR(10),
  billingDocumentType NVARCHAR(4),
  billingDocumentDate DATE,
  soldToParty NVARCHAR(10),
  payerParty NVARCHAR(10),
  partyNumber NVARCHAR(10),
  partyName NVARCHAR(100),
  vehicleNumber NVARCHAR(100),
  transactionCurrency NVARCHAR(3),
  totalNetAmount DECIMAL(15, 2),
  totalGrossAmount DECIMAL(15, 2),
  totalTaxAmount DECIMAL(13, 2),
  gateEntry_ID NVARCHAR(36),
  PRIMARY KEY(ID)
)