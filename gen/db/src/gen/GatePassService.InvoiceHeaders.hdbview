VIEW GatePassService_InvoiceHeaders AS SELECT
  InvoiceHeaders_0.createdAt,
  InvoiceHeaders_0.createdBy,
  InvoiceHeaders_0.modifiedAt,
  InvoiceHeaders_0.modifiedBy,
  InvoiceHeaders_0.ID,
  InvoiceHeaders_0.billingDocument,
  InvoiceHeaders_0.billingDocumentType,
  InvoiceHeaders_0.billingDocumentDate,
  InvoiceHeaders_0.soldToParty,
  InvoiceHeaders_0.payerParty,
  InvoiceHeaders_0.partyNumber,
  InvoiceHeaders_0.partyName,
  InvoiceHeaders_0.vehicleNumber,
  InvoiceHeaders_0.transactionCurrency,
  InvoiceHeaders_0.totalNetAmount,
  InvoiceHeaders_0.totalGrossAmount,
  InvoiceHeaders_0.totalTaxAmount,
  InvoiceHeaders_0.gateEntry_ID
FROM com_mdasad_gatepass_InvoiceHeaders AS InvoiceHeaders_0