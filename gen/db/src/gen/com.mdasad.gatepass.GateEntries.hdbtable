COLUMN TABLE com_mdasad_gatepass_GateEntries (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  gateEntryNumber NVARCHAR(20),
  gateEntryYear INTEGER,
  movementType NVARCHAR(5000) NOT NULL,
  documentStatus NVARCHAR(5000) DEFAULT 'OPEN',
  entryStatus NVARCHAR(5000) DEFAULT 'CREATED',
  plant NVARCHAR(10),
  partyNumber NVARCHAR(20),
  partyName NVARCHAR(100),
  referenceType NVARCHAR(5000),
  referenceNumber NVARCHAR(20),
  vehicleNumber NVARCHAR(20) NOT NULL,
  vehicleType NVARCHAR(20) NOT NULL,
  transporterNumber NVARCHAR(20),
  transporterName NVARCHAR(100) NOT NULL,
  driverName NVARCHAR(100) NOT NULL,
  driverContact NVARCHAR(20),
  lrNumber NVARCHAR(50),
  entryDate DATE NOT NULL,
  entryTime TIME,
  remarks NVARCHAR(500),
  invoiceDate DATE,
  invoiceValue NVARCHAR(50),
  eWayBillNumber NVARCHAR(50),
  eWayBillDate DATE,
  shippingAddress NVARCHAR(250),
  passDate DATE,
  passTime TIME,
  passRemarks NVARCHAR(500),
  materialItemsJson NCLOB,
  PRIMARY KEY(ID)
)