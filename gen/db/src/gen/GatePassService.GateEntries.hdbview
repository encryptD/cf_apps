VIEW GatePassService_GateEntries AS SELECT
  GateEntries_0.createdAt,
  GateEntries_0.createdBy,
  GateEntries_0.modifiedAt,
  GateEntries_0.modifiedBy,
  GateEntries_0.ID,
  GateEntries_0.gateEntryNumber,
  GateEntries_0.gateEntryYear,
  GateEntries_0.movementType,
  GateEntries_0.documentStatus,
  GateEntries_0.entryStatus,
  GateEntries_0.plant,
  GateEntries_0.partyNumber,
  GateEntries_0.partyName,
  GateEntries_0.referenceType,
  GateEntries_0.referenceNumber,
  GateEntries_0.vehicleNumber,
  GateEntries_0.vehicleType,
  GateEntries_0.transporterNumber,
  GateEntries_0.transporterName,
  GateEntries_0.driverName,
  GateEntries_0.driverContact,
  GateEntries_0.lrNumber,
  GateEntries_0.entryDate,
  GateEntries_0.entryTime,
  GateEntries_0.remarks,
  GateEntries_0.invoiceDate,
  GateEntries_0.invoiceValue,
  GateEntries_0.eWayBillNumber,
  GateEntries_0.eWayBillDate,
  GateEntries_0.shippingAddress,
  GateEntries_0.passDate,
  GateEntries_0.passTime,
  GateEntries_0.passRemarks,
  GateEntries_0.materialItemsJson
FROM com_mdasad_gatepass_GateEntries AS GateEntries_0