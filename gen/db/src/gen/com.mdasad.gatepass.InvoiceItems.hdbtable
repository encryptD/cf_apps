COLUMN TABLE com_mdasad_gatepass_InvoiceItems (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  parent_ID NVARCHAR(36) NOT NULL,
  billingDocumentItem NVARCHAR(6),
  "PRODUCT" NVARCHAR(18),
  itemText NVARCHAR(200),
  billingQuantity DECIMAL(13, 3),
  unit NVARCHAR(3),
  netAmount DECIMAL(15, 2),
  plant NVARCHAR(4),
  storageLocation NVARCHAR(4),
  PRIMARY KEY(ID)
)